{
  "name": "greenoffice-homepage",
  "version": "1.0.0",
  "description": "그린오피스 홈페이지",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --watch",
    "test:saddle": "node scripts/test-saddle-calculator.mjs",
    "test:perfect": "node scripts/test-perfect-calculator.mjs",
    "test:wire": "node scripts/test-wire-calculator.mjs",
    "test:utils": "node scripts/test-book-calculator-utils.mjs",
    "test:book-ui": "node scripts/test-book-ui-modules.mjs",
    "test:book-form": "node scripts/test-book-form-data.mjs",
    "test:book-state": "node scripts/test-book-page-state.mjs",
    "test:book-request": "node scripts/test-book-request-data.mjs",
    "test:firestore-security": "node scripts/test-firestore-rules-contract.mjs",
    "test:qna-security": "node scripts/test-qna-security-contract.mjs",
    "test:storage-security": "node scripts/test-storage-rules-contract.mjs",
    "test:public-feed": "node scripts/test-public-feed-contract.mjs",
    "test:ai-security": "node scripts/test-ai-security-contract.mjs",
    "test:security": "npm run test:firestore-security && npm run test:qna-security && npm run test:storage-security && npm run test:public-feed && npm run test:ai-security",
    "test:book": "npm run test:saddle && npm run test:perfect && npm run test:wire && npm run test:utils && npm run test:book-ui && npm run test:book-form && npm run test:book-state && npm run test:book-request",
    "test:ci": "npm run test:book && npm run test:security"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
