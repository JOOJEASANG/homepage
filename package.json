{
  "name": "greenoffice-homepage",
  "version": "1.0.0",
  "description": "그린오피스 홈페이지",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --watch",
    "test:saddle": "node scripts/test-saddle-calculator.mjs",
    "test:perfect": "node scripts/test-perfect-calculator.mjs",
    "test:wire": "node scripts/test-wire-calculator.mjs",
    "test:utils": "node scripts/test-book-calculator-utils.mjs",
    "test:book": "npm run test:saddle && npm run test:perfect && npm run test:wire && npm run test:utils && npm run test:book-ui",
    "test:book-ui": "node scripts/test-book-ui-modules.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
