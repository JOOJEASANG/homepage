rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function quoteData(quoteId) {
      return firestore.get(/databases/(default)/documents/quotes/$(quoteId)).data;
    }

    function canAccessQuote(quoteId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/quotes/$(quoteId))
        && (
          isAdmin()
          || quoteData(quoteId).userId == request.auth.uid
          || (quoteData(quoteId).isGuest == true && quoteData(quoteId).guestUid == request.auth.uid)
          || (
            quoteData(quoteId).isGuest == true
            && request.auth.token.guestLookupKey != null
            && quoteData(quoteId).guestLookupKey == request.auth.token.guestLookupKey
          )
        );
    }

    function allowedUpload(fileName) {
      return request.resource != null
        && request.resource.size <= 300 * 1024 * 1024
        && fileName.lower().matches('.*\\.(pdf|jpg|jpeg|png|gif|webp|heic|tif|tiff|zip|doc|docx|xls|xlsx|ppt|pptx|hwp|hwpx|ai|eps|psd|indd)$');
    }

    match /quotes/{quoteId}/attachments/{fileName} {
      allow read: if canAccessQuote(quoteId);
      allow create, update: if canAccessQuote(quoteId) && allowedUpload(fileName);
      allow delete: if canAccessQuote(quoteId);
    }

    // 마이페이지/관리자 1:1 상담 파일은 현재 quotes/{quoteId}/{timestamp}_{filename} 경로를 사용합니다.
    match /quotes/{quoteId}/{fileName} {
      allow read: if canAccessQuote(quoteId);
      allow create, update: if canAccessQuote(quoteId) && allowedUpload(fileName);
      allow delete: if canAccessQuote(quoteId);
    }

    // 공개 콘텐츠는 다운로드 URL 또는 아래 공개 폴더에서만 읽을 수 있습니다.
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /previews/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /imagePreviews/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 그 밖의 저장소 경로는 관리자만 접근합니다.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
